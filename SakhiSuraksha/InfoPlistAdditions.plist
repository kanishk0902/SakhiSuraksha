<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Dev-only App Transport Security exception so a physical iPhone on the
	same Wi-Fi network can reach the local Safe Route ML server running on
	this Mac (http://<Mac-LAN-IP>:8000 — see ml/README.txt). The iOS
	Simulator does not need this: literal "localhost"/127.0.0.1 connections
	are exempt from ATS automatically.

	CORRECTNESS NOTE: this previously used "NSAllowsLocalNetworking", which
	is NOT a real ATS key (it's easily confused with the unrelated Local
	Network privacy permission, NSLocalNetworkUsageDescription) — it was
	silently ignored, so plain HTTP to a real LAN IP (e.g. 10.58.183.99) was
	still blocked by ATS even though "localhost" itself worked, which is why
	Simulator testing looked fine while physical-device testing failed with
	"server unreachable." NSAllowsArbitraryLoads is the real key that
	disables ATS's HTTPS requirement — used here because the dev Mac's LAN
	IP changes between Wi-Fi networks, so a specific per-domain exception
	would need editing every time; a per-domain exception is more scoped if
	you'd rather maintain it as the IP changes.

	This is a local-development convenience for a feature with no shipping
	backend yet. Before shipping to real users, either move Safe Route to a
	real HTTPS-hosted backend and remove this exception, or scope it to a
	specific known dev-server domain instead of NSAllowsArbitraryLoads.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<false/>
	</dict>
	<!--
	Lets an active journey keep tracking location (for deviation detection
	and the discreet safety notification) after the screen locks or the user
	switches apps — the whole point of a safety-monitoring journey is that it
	doesn't stop the moment the phone goes in a pocket. Combined with
	CLLocationManager.allowsBackgroundLocationUpdates, set only while a
	journey is active (see JourneyService/LocationService).
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
</dict>
</plist>
